[Unit]
Description=Oura local worker (%i)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/davis/oura-community-leaderboard/staging
Environment=OURA_CONFIG_FILE=/home/davis/oura-community-leaderboard/private/config.json
ExecStart=/usr/bin/node --max-old-space-size=512 worker.mjs %i
UMask=0077
NoNewPrivileges=true
MemoryMax=768M
CPUQuota=75%
Nice=10
TimeoutStartSec=180
