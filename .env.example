# Oura OAuth proxy (server-only secret)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Optional when the request-provided origin is accepted by your Oura app.
OURA_REDIRECT_URI=http://localhost:3000

# Public Oura application id used to construct the browser authorization URL.
VITE_OURA_CLIENT_ID=

# Webhook management
OURA_WEBHOOK_VERIFICATION_TOKEN=
# Optional comma-separated override.
OURA_WEBHOOK_DATA_TYPES=daily_sleep,daily_readiness,daily_activity,sleep,workout,session,tag,spo2

# Firebase Admin for server-side webhook writes. Prefer the JSON form in CI.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or configure the split fields instead:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional public Firebase project override. Checked-in defaults preserve the
# existing deployment; these values make another environment configurable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
