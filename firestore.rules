rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: any client can read/write
    // (no Firebase Auth – app uses Oura OAuth only)
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Webhook signals: read/write by clients and server
    match /webhookSignals/{signalId} {
      allow read, write: if true;
    }

    // Competitions: any authenticated-or-anonymous client can read/write
    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Competition invites: readable/writable for invite flows
    match /competitionInvites/{inviteId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
