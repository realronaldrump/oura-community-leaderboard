rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile metadata remains readable for the shared leaderboard.
    // OAuth secrets and destructive lifecycle operations are server-only.
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['token', 'refreshToken', 'tokenExpiresAt', 'ouraUserId', 'lastSyncError', 'lastSyncErrorAt', 'lastSuccessfulSyncAt']);
      allow delete: if false;
    }

    // Webhook delivery and consumption are entirely server-owned.
    match /webhookSignals/{signalId} {
      allow read, write: if false;
    }

    // OAuth credentials are written and read only through Firebase Admin in
    // server functions. Browser clients must never access this collection.
    match /ouraCredentials/{profileId} {
      allow read, write: if false;
    }

    // Competitions: any authenticated-or-anonymous client can read/write
    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Competition invites: readable/writable for invite flows
    match /competitionInvites/{inviteId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Shared Oura metric history is readable by the leaderboard and written
    // only by background server functions.
    match /profileStats/{profileId} {
      allow read: if true;
      allow write: if false;

      match /{statsCollection}/{statsDocument} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
