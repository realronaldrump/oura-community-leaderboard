{
  "crons": [
    {
      "path": "/api/cron/oura-sync",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/cron/insights",
      "schedule": "45 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
