{
  "crons": [
    {
      "path": "/api/cron/oura-sync",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/cron/insights",
      "schedule": "45 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/storage/public/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/storage/public/:path*",
      "destination": "https://davis-mini-pc-1.tail59b3f5.ts.net:8443/public/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
